  "chart_contract": {
    "id": "Q04_iris_confusion",
    "kind": "confusion_matrix",
    "claim": "A simple nearest-neighbor baseline makes some cross-species errors.",
    "x": "predicted_species",
    "y": "actual_species",
    "group": "species",
    "derived_fields": {
      "predicted_species": {
        "type": "category",
        "unit": "category",
        "source_fields": [
          "sepal_length_cm",
          "sepal_width_cm",
          "petal_length_cm",
          "petal_width_cm",
          "species"
        ],
        "derivation": "For each source row, predict species using leave-one-out Euclidean 1-NN on the four unscaled measurements; source row order resolves distance ties."
      },
      "actual_species": {
        "type": "category",
        "unit": "category",
        "source_fields": [
          "species"
        ],
        "derivation": "Copy the source species label without changing categories."
      }
    },
    "sample_size": 150,
    "encoding": {
      "color": "count",
      "text": "count"
    },
    "statistics": {
      "display": "raw_counts",
      "interval": "none",
      "algorithm": {
        "classifier": "nearest_neighbor",
        "k": 1,
        "distance": "euclidean",
        "feature_scaling": "none",
        "validation": "leave_one_out",
        "distance_tie_break": "lowest_source_row",
        "features": [
          "sepal_length_cm",
          "sepal_width_cm",
          "petal_length_cm",
          "petal_width_cm"
        ]
      }
    },
    "axes": {
      "x": {
        "type": "category",
        "field": "predicted_species",
        "unit": "category",
        "categories": [
          "Iris-setosa",
          "Iris-versicolor",
          "Iris-virginica"
        ]
      },
      "y": {
        "type": "category",
        "field": "actual_species",
        "unit": "category",
        "categories": [
          "Iris-setosa",
          "Iris-versicolor",
          "Iris-virginica"
        ]
      }
    },
    "caption": "Counts are from 150 deterministic leave-one-out predictions. This is a demonstrator baseline, not a published model result."
