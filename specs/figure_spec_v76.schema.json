{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/clonetimer/PPT-Skill/specs/figure_spec_v76.schema.json",
  "title": "Scientific FigureSpec evidence contract",
  "type": "object",
  "required": ["schema_version", "id", "canvas", "style", "figure_contract", "evidence_records", "elements"],
  "properties": {
    "schema_version": {"const": "7.6.0-dev"},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string"},
    "title": {"type": "string"},
    "canvas": {"type": "object", "required": ["width_in", "height_in"], "properties": {"width_in": {"type": "number", "exclusiveMinimum": 0}, "height_in": {"type": "number", "exclusiveMinimum": 0}}},
    "style": {"type": "object"},
    "figure_contract": {
      "type": "object", "required": ["claim", "archetype", "output_mode", "unverified"],
      "properties": {
        "claim": {"type": "string", "minLength": 1},
        "archetype": {"enum": ["quantitative_grid", "schematic_led_composite", "image_quantitative_composite", "image_plate_plus_quant", "asymmetric_mixed_modality"]},
        "output_mode": {"enum": ["presentation", "publication"]},
        "unverified": {"type": "array", "items": {"type": "string"}}
      }
    },
    "evidence_records": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
    "data_lineage": {"$ref": "#/$defs/dataLineage"},
    "chart_contract": {"type": "object", "required": ["id", "claim", "kind"],
      "properties": {"id": {"type": "string", "minLength": 1},
        "claim": {"type": "string", "minLength": 1}, "kind": {"type": "string", "minLength": 1}}},
    "semantic_edges": {"type": "array", "items": {"type": "array", "prefixItems": [{"type": "string"}, {"type": "string"}], "minItems": 2, "maxItems": 2}},
    "elements": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/element"}}
  },
  "allOf": [{"if": {"required": ["figure_contract"],
    "properties": {"figure_contract": {"properties": {"archetype": {"const": "quantitative_grid"}}}}},
    "then": {"required": ["data_lineage", "chart_contract"]}}],
  "$defs": {
    "dataLineage": {"type": "object",
      "required": ["data_ref", "sha256", "source_url", "doi", "row_count", "chart_spec", "chart_spec_sha256"],
      "properties": {
        "data_ref": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_url": {"type": "string", "minLength": 1},
        "doi": {"type": "string", "minLength": 1},
        "row_count": {"type": "integer", "minimum": 1},
        "chart_spec": {"type": "string", "minLength": 1},
        "chart_spec_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "evidence": {
      "type": "object", "required": ["id", "source", "source_file_sha256", "source_locator", "status", "scope", "reuse"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "source_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_locator": {"type": "string", "minLength": 1},
        "status": {"enum": ["source_visible_redraw", "source_artwork_excerpt", "paper_grounded", "domain_adaptation", "data_driven"]},
        "scope": {"type": "string", "minLength": 1},
        "reuse": {"type": "string", "minLength": 1}
      }
    },
    "element": {
      "type": "object", "required": ["id", "type", "semantic_role", "evidence_ref"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"enum": ["text", "rect", "line", "polyline", "polygon", "ellipse", "trapezoid", "sensor", "graph", "grid", "stack_grid", "image"]},
        "semantic_role": {"type": "string", "minLength": 1},
        "evidence_ref": {"type": "string", "minLength": 1},
        "semantic_id": {"type": "string"},
        "semantic_link": {"type": "string"},
        "head_id": {"type": "string", "minLength": 1},
        "arrow_size": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  }
}
